      "targets": [
        {
          "expr": "max(up) by (instance)",
          "format": "table",
          "instant": true,
          "legendFormat": "Status",
          "refId": "A"
        },
        {
          "expr": "max(wealth_usd) by (instance)",
          "format": "table",
          "instant": true,
          "legendFormat": "Equity USD",
          "refId": "B"
