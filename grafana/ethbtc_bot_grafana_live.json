        {
          "expr": "max(pnl_quote) by (instance)",
          "format": "table",
          "instant": true,
          "legendFormat": "PnL Session",
          "refId": "C"
        },
        {
          "expr": "max(margin_utilization_pct) by (instance)",
          "format": "table",
          "instant": true,
          "legendFormat": "Margin %",
          "refId": "D"
        },
        {
          "expr": "max(liquidation_distance_pct) by (instance)",
          "format": "table",
          "instant": true,
          "legendFormat": "Liq Dist %",
          "refId": "E"
        },
        {
          "expr": "max(leverage) by (instance)",
          "format": "table",
          "instant": true,
          "legendFormat": "Lev x",
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "mode": "outer",
            "byField": "instance"
